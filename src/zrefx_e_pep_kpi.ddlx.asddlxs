@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Imputacion',
    typeNamePlural: 'Imputacion',
    title: { value: 'SituacionTxt' }
  },
  presentationVariant: [{
    sortOrder: [{ by: 'Situacion', direction: #ASC }],
    visualizations: [{ type: #AS_LINEITEM }]
  }]
}
annotate view ZREFX_I_PEP_KPI with
{
  @UI.hidden: true
  Situacion;

  @UI.lineItem: [{ position: 10, label: 'Situacion' }]
  @UI.identification: [{ position: 10, label: 'Situacion' }]
  SituacionTxt;

  @UI.lineItem: [{ position: 20, label: 'Expedientes', criticality: 'Criticality' }]
  @UI.dataPoint: { title: 'Expedientes', criticality: 'Criticality' }
  NumExpedientes;

  @UI.hidden: true
  Criticality;
}